<?xml version="1.0" encoding="UTF-8"?>
<!-- E1 线圈检测器（induction loop）定义：
     m1_d0 / m1_d1 : 主线上游两车道（汇入点前 60 m），统计主线到达流量
     m2_d0 / m2_d1 : 汇入后主线两股直行车流（ALINEA 下游占用率反馈来源）
     ramp_d        : 匝道上停车线附近，测量匝道需求与排队释放
     period="1" 表示每 1 s 聚合一次写入输出文件 -->
<additional>
    <inductionLoop id="m1_d0"  lane="main1_0" pos="940" period="1" file="detector_output.xml" friendlyPos="x"/>
    <inductionLoop id="m1_d1"  lane="main1_1" pos="940" period="1" file="detector_output.xml" friendlyPos="x"/>
    <inductionLoop id="m2_d0"  lane="main2_1" pos="60"  period="1" file="detector_output.xml" friendlyPos="x"/>
    <inductionLoop id="m2_d1"  lane="main2_2" pos="60"  period="1" file="detector_output.xml" friendlyPos="x"/>
    <inductionLoop id="ramp_d" lane="ramp1_0" pos="340" period="1" file="detector_output.xml" friendlyPos="x"/>
</additional>
