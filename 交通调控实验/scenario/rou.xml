<?xml version="1.0" encoding="UTF-8"?>
<!-- 交通需求定义（复现论文 B §3 的需求设置）：
     主线：0-400s 1000 veh/h，400-1600s 增至 1500 veh/h，1600-2000s 回落 1000 veh/h
     匝道：0-2000s 恒定 500 veh/h
     仿真时长 2000 s。
     vType 定义车辆动力学属性（跟驰/换道模型的参数载体）。 -->
<routes>
    <vType id="car" vClass="passenger" length="5.0" maxSpeed="41.0"
           accel="2.6" decel="4.5" sigma="0.5" speedFactor="normc(1.0,0.2,0.7,1.3)"/>

    <route id="mainline" edges="main1 main2"/>
    <route id="onramp"   edges="ramp1 ramp2 main2"/>

    <!-- 注意：SUMO 要求 flow 按 begin 时间排序，否则后面的 flow 会被忽略（这是个常见坑） -->
    <flow id="main_a" type="car" route="mainline" begin="0"    end="400"  vehsPerHour="1000" departLane="best" departSpeed="max"/>
    <flow id="ramp_a" type="car" route="onramp"   begin="0"    end="2000" vehsPerHour="500"  departLane="best" departSpeed="max"/>
    <flow id="main_b" type="car" route="mainline" begin="400"  end="1600" vehsPerHour="1500" departLane="best" departSpeed="max"/>
    <flow id="main_c" type="car" route="mainline" begin="1600" end="2000" vehsPerHour="1000" departLane="best" departSpeed="max"/>
</routes>
